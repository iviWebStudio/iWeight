# API (apps/api) — реальные значения только в .env / секретах хостинга
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://weight_api:weight_api_local@localhost:5432/weight_ai_dev
TEST_DATABASE_URL=postgres://weight_api:weight_api_local@localhost:5432/weight_ai_test
AUTH_PROVIDER=local              # supabase | local (local запрещён в production)
LOCAL_JWT_SECRET=                # только для AUTH_PROVIDER=local, ≥32 символа
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # только сервер; никогда в web/mobile
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_TOOL_ITERATIONS=6
OPENAI_TIMEOUT_MS=30000
OPENAI_PRICE_INPUT_PER_MTOK=0     # USD за 1M входных токенов (для учёта расходов; 0 = не считать)
OPENAI_PRICE_OUTPUT_PER_MTOK=0    # USD за 1M выходных токенов
CHAT_DAILY_TOKEN_BUDGET=200000    # на пользователя в сутки (по его часовому поясу); 0 = без лимита
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=12
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=false                 # true за обратным прокси (верный IP для лимитов)
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Web (apps/web) — публичные
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
